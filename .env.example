# ==============================================
# Environment Variables Template
# Copy this file to .env and fill in the values
# ==============================================

# --- General ---
COMPOSE_PROJECT_NAME=microservices-assignment
ENVIRONMENT=development

# --- Eureka ---
EUREKA_PORT=8761

# --- Auth Service MySQL ---
AUTH_DB_PORT=3306
AUTH_DB_NAME=auth_service_db
AUTH_DB_ROOT_PASSWORD=root
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=root

# --- Exam Service MySQL ---
EXAM_DB_PORT=3308
EXAM_DB_NAME=exam_service_db
EXAM_DB_ROOT_PASSWORD=root
EXAM_DB_USERNAME=root
EXAM_DB_PASSWORD=root

# --- Question Service MySQL ---
QUESTION_DB_PORT=3307
QUESTION_DB_NAME=question_service_db
QUESTION_DB_ROOT_PASSWORD=root
QUESTION_DB_USERNAME=root
QUESTION_DB_PASSWORD=root

# --- Global DB credentials used by services ---
DB_USERNAME=root
DB_PASSWORD=change-me-db-password

# --- Result Service MySQL ---
RESULT_DB_PORT=3309
RESULT_DB_NAME=result_service_db
RESULT_DB_ROOT_PASSWORD=root

# --- Class Service MySQL ---
CLASS_DB_PORT=3311
CLASS_DB_NAME=class_service_db
CLASS_DB_ROOT_PASSWORD=root

# --- Notification Service MySQL ---
NOTIFICATION_DB_PORT=3312
NOTIFICATION_DB_NAME=notification_service_db
NOTIFICATION_DB_ROOT_PASSWORD=root

# --- Auth ---
JWT_SECRET=change-me-super-secret-key-change-me-super-secret-key
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# --- RabbitMQ ---
RABBITMQ_PASSWORD=guest

# --- Gateway CORS (comma-separated patterns). Optional: one-domain HTTPS is auto-allowed when Origin host = Host/X-Forwarded-Host. Use this when FE and API are different hosts (e.g. api. vs app.). Default patterns: http://localhost:*,http://127.0.0.1:* ---
# CORS_ALLOWED_ORIGINS=https://api.example.com,http://localhost:*,http://127.0.0.1:*

# --- Service Ports ---
AUTH_SERVICE_PORT=8081
EXAM_SERVICE_PORT=8082
QUESTION_SERVICE_PORT=8083
REDIS_PORT=6379
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# --- Add more variables as needed for your stack ---
# REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://localhost:5672

# --- AI question generation ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_TIMEOUT_SECONDS=60
OPENAI_TIMEOUT_SECONDS=60

# --- Mail (notification-service) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=E-Mid Quiz System
